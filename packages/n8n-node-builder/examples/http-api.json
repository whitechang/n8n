{
	"name": "myApiNode",
	"displayName": "我的 API 节点",
	"description": "调用自定义 API 并处理响应",
	"type": "http",
	"apiUrl": "https://api.example.com/process",
	"color": "#FF6B6B",
	"group": ["transform"],
	"properties": {
		"inputText": {
			"type": "string",
			"displayName": "输入文本",
			"description": "要处理的文本内容",
			"placeholder": "请输入文本...",
			"required": true
		},
		"operation": {
			"type": "string",
			"displayName": "操作类型",
			"description": "选择要执行的操作",
			"enum": ["uppercase", "lowercase", "reverse"],
			"default": "uppercase"
		},
		"includeMetadata": {
			"type": "boolean",
			"displayName": "包含元数据",
			"description": "是否在响应中包含元数据",
			"default": false
		},
		"maxLength": {
			"type": "number",
			"displayName": "最大长度",
			"description": "处理文本的最大长度",
			"default": 1000
		}
	}
}
